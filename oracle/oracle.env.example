# Add these lines to the .env you already filled in (the guide shows how):
#   cat oracle/oracle.env.example >> .env     then open .env and replace the values.
#
# Makes plain "docker compose up -d" use the Oracle add-on too. Leave this line as it is.
COMPOSE_FILE=docker-compose.yml:oracle/docker-compose.oracle.yml
#
# DOMAIN: the name your server answers to. No domain? Use your IP with dashes plus .sslip.io, e.g. 129-151-10-20.sslip.io
DOMAIN=129-151-10-20.sslip.io
# The login the browser asks for before it shows the cockpit.
APP_USER=admin
# Create the hash with:  docker run --rm caddy caddy hash-password --plaintext 'a-long-password'
# Keep the single quotes around it, or Docker reads the $ signs as variables.
APP_PASSWORD_HASH='paste-the-hash-here'

# Oracle's free VM sends mail only on ports 465, 587 and 993. Use those for SMTP and IMAP (port 25 is blocked).
